# FP Nexus Agent - Environment Template
PORT=8001
HOST=0.0.0.0

# Active Multi-Model Provider (openrouter, ollama, openai, anthropic, gemini)
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Free Models Default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free

# Local Ollama Configuration (100% Free & Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Target Platform Defaults
DEFAULT_PLATFORM=fiverr

# SEO Schedule Intervals (Days)
SEO_WEEKLY_INTERVAL_DAYS=7
SEO_DEEP_AUDIT_INTERVAL_DAYS=14
